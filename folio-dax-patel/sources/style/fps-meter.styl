.fps-meter
    position fixed
    top 12px
    right 12px
    z-index 40
    font-family 'Pally', system-ui, sans-serif
    pointer-events none
    display flex
    flex-direction column
    align-items flex-end
    gap 8px

    &__toggle
        pointer-events auto
        border none
        cursor pointer
        padding 6px 10px
        border-radius 6px
        background rgba(20, 16, 32, 0.72)
        color #f4f0e6
        font-size 11px
        font-weight 600
        letter-spacing 0.06em
        backdrop-filter blur(8px)

        &:hover
            background rgba(40, 32, 60, 0.85)

    &__panel
        pointer-events none
        min-width 132px
        padding 10px 12px
        border-radius 10px
        background rgba(16, 12, 28, 0.78)
        color #f4f0e6
        backdrop-filter blur(10px)
        box-shadow none
        display none

    &.is-visible &__panel
        display block

    &__row
        display flex
        align-items baseline
        gap 6px

    &__value
        font-size 28px
        font-weight 700
        line-height 1
        font-variant-numeric tabular-nums

    &__unit
        font-size 11px
        opacity 0.7

    &__tier
        margin-top 6px
        font-size 12px
        font-weight 600
        text-transform uppercase
        letter-spacing 0.04em

    &__hint
        margin-top 2px
        font-size 10px
        opacity 0.65
        line-height 1.3

    &__quality
        margin-top 6px
        font-size 10px
        opacity 0.55

    &[data-tier='excellent'] &__value,
    &[data-tier='excellent'] &__tier
        color #2ec4b6

    &[data-tier='good'] &__value,
    &[data-tier='good'] &__tier
        color #a7c957

    &[data-tier='ok'] &__value,
    &[data-tier='ok'] &__tier
        color #ffb703

    &[data-tier='low'] &__value,
    &[data-tier='low'] &__tier
        color #ff9f1c

    &[data-tier='rough'] &__value,
    &[data-tier='rough'] &__tier
        color #ff006e
